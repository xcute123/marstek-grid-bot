BOT_TOKEN=ваш_токен_от_BotFather
# Необязательно: если ADMIN_ID=0 или не задан, первый написавший /start автоматически станет админом
ADMIN_ID=0
# Интервал опроса облака Marstek в секундах (по умолчанию 180)
POLL_SEC=180
# Mini App (веб-приложение внутри Telegram). 0 — выключить
WEBAPP=1
WEBAPP_PORT=8765
